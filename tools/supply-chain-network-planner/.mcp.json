{
  "mcpServers": {
    "supply_chain_data": {
      "command": "./bin/supply-chain-planner-launcher",
      "args": [
        "--data-server",
        "--workspace-root",
        "."
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "OPEN_WEB_CODEX_DATA_DIR",
        "OPEN_WEB_CODEX_LOG_DIR",
        "OPEN_WEB_CODEX_SUPPLY_CHAIN_MCP_VENV",
        "SUPPLY_CHAIN_READONLY_DATA_ROOT",
        "SUPPLY_CHAIN_DATA_RESOURCE_DIR",
        "SUPPLY_CHAIN_MCP_AUTO_INSTALL",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "all_proxy",
        "no_proxy"
      ]
    },
    "supply_chain_planner": {
      "command": "./bin/supply-chain-planner-launcher",
      "args": [
        "--workspace-root",
        "."
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "OPEN_WEB_CODEX_DATA_DIR",
        "OPEN_WEB_CODEX_LOG_DIR",
        "OPEN_WEB_CODEX_SUPPLY_CHAIN_MCP_VENV",
        "SUPPLY_CHAIN_DATA_ROOT",
        "SUPPLY_CHAIN_RESOURCE_DIR",
        "SUPPLY_CHAIN_MCP_AUTO_INSTALL",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "all_proxy",
        "no_proxy"
      ]
    }
  }
}
